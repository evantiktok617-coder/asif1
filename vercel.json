{
  "version": 2,
  "builds": [
    { "src": "*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/zubair", "dest": "/zubair.js" },
    { "src": "/chumpa", "dest": "/chumpa.js" },
    { "src": "/tufail", "dest": "/tufail.js" },
    { "src": "/ayan", "dest": "/ayan.js" },
    { "src": "/furqan", "dest": "/furqan.js" },
    { "src": "/kami", "dest": "/kami.js" },
    { "src": "/as", "dest": "/as.js" },
    { "src": "/abd", "dest": "/abd.js" }
  ]
}
